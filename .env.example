# Local Ollama endpoint. The app uses its OpenAI-compatible /v1 endpoint.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_DEFAULT_MODEL=gpt-oss
OLLAMA_AUTO_SELECT_MODEL=true
# Comma-separated models to ensure are downloaded during setup.
# To save disk space, keep only one model here.
OLLAMA_MODELS_TO_PULL=gpt-oss

# Set these only if you want optional targeted online research.
# Keep real API keys in your local .env and never commit them.
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENAI_RESEARCH_MODEL=gpt-4.1-mini
# Preferred Gemini model; the research pipeline falls back through GEMINI_RESEARCH_MODELS.
GEMINI_RESEARCH_MODEL=gemini-3.1-flash-lite
GEMINI_RESEARCH_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-3.6-flash,gemini-3.8-flash
RESEARCH_MAX_QUERIES=3
LAYOUT_GALLERY_COLUMNS=9

# Automatically populated by setup_environment.py. Do not normally edit these.
COMFYUI_DIR=
COMFYUI_PYTHON=
COMFYUI_ARGS=--listen 127.0.0.1 --port 8188
COMFYUI_TORCH_INDEX_URL=
COMFYUI_ZIMAGE_DIFFUSION_MODEL=z_image_turbo_int8_convrot.safetensors
COMFYUI_ZIMAGE_TEXT_ENCODER=qwen_3_4b_fp8_mixed.safetensors
